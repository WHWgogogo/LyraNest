{
  "version": 1,
  "minimum_confidence": 0.75,
  "sources": [{
    "name": "netease",
    "enabled": false,
    "confidence_scorer": "fuzzy_v1",
    "search": {
      "url": "https://licensed-gateway.example/netease/search?query={query}&limit={limit}",
      "method": "GET",
      "headers": {"User-Agent": "LyraNest/0.1.9"},
      "response_mapping": {
        "items_path": "result.songs",
        "id_field": "id",
        "title_field": "name",
        "artist_field": "ar[0].name",
        "album_field": "al.name",
        "cover_field": "al.picUrl",
        "duration_field": "dt",
        "duration_unit": "ms"
      }
    },
    "lyrics": {
      "url": "https://licensed-gateway.example/netease/lyrics?id={id}",
      "method": "GET",
      "response_mapping": {"lrc_path": "lrc.lyric", "translated_path": "tlyric.lyric"}
    }
  }]
}
