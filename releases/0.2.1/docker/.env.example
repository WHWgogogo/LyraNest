LYRANEST_VERSION=0.2.1
SERVER_PORT=8080

MUSIC_LIBRARY_HOST_DIR=./music
DATA_DIR=./data
CACHE_DIR=./cache

SERVER_MEMORY_LIMIT=256m
SERVER_MEMORY_RESERVATION=128m
GOMEMLIMIT=192MiB
GOGC=100
MEDIA_EXTRACT_CONCURRENCY=4
MEDIA_SCRAPE_CONCURRENCY=2
MUSIC_LOW_MEMORY=0

MUSICBRAINZ_USER_AGENT=LyraNest/0.2.1 (+https://github.com/WHWgogogo/LyraNest)
MUSICBRAINZ_BASE_URL=https://musicbrainz.org
MUSICBRAINZ_TIMEOUT=20s
SCRAPER_PROVIDER_CONFIG=

LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
AUTH_SESSION_TTL=24h
LYRANEST_DISCOVERY=1

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
