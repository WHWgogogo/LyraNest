# Copy this file to .env before running docker compose.

# Host port published by the embedded Web UI and API.
SERVER_PORT=8080
# Docker image tag for online deployment.
LYRANEST_VERSION=0.2.0

# Run the server with the UID/GID that owns the mounted music directory.
# On Linux, run `id -u` and `id -g` to obtain these values.
PUID=1000
PGID=1000

# Host paths mounted into the container.
# MUSIC_LIBRARY_HOST_DIR is mounted read-only at /music. Runtime data,
# metadata, and caches are persisted under DATA_DIR and CACHE_DIR instead.
MUSIC_LIBRARY_HOST_DIR=./music
DATA_DIR=./data
CACHE_DIR=./cache

# Server runtime defaults.
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
# Increase these only after measuring RSS, CPU, and I/O for your library.
SERVER_MEMORY_LIMIT=256m
SERVER_MEMORY_RESERVATION=128m
GOMEMLIMIT=192MiB
GOGC=100
# Set to 1 to make batch scraping return freed pages to the host as it runs.
# The container memory limit already bounds the heap, so this is only useful
# when you want the reported RSS to track the live set closely.
MUSIC_LOW_MEMORY=0

# Identify this installation to MusicBrainz. Set a maintained contact URL or
# email address for production deployments.
MUSICBRAINZ_USER_AGENT=LyraNest/0.2.0 (+https://github.com/WHWgogogo/LyraNest)
# Keep the official MusicBrainz endpoint unless you operate a trusted,
# API-compatible endpoint.
MUSICBRAINZ_BASE_URL=https://musicbrainz.org
# Total timeout for each MusicBrainz HTTP request. Must be a positive Go duration.
MUSICBRAINZ_TIMEOUT=20s

# Optional path inside the server container to an operator-supplied provider
# JSON file. No NetEase/QQ Music/KuGou endpoint is enabled or shipped by default.
SCRAPER_PROVIDER_CONFIG=

# Optional outbound proxy settings passed through to the server container.
# Leave empty for direct connections. NO_PROXY accepts comma-separated hosts.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
