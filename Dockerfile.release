ARG VERSION=0.2.6

FROM alpine:3.20

ARG VERSION
ARG TARGETARCH
LABEL org.opencontainers.image.title="LyraNest-server" \
      org.opencontainers.image.description="Self-hosted LyraNest server" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/WHWgogogo/LyraNest"

WORKDIR /app
RUN apk add --no-cache ca-certificates ffmpeg tzdata

COPY releases/${VERSION}/docker/linux-${TARGETARCH}/music-player-server-linux-${TARGETARCH} /usr/local/bin/music-player-server
RUN chmod 0755 /usr/local/bin/music-player-server

ENV SERVER_ADDR=:8080 \
    MUSIC_LIBRARY_DIR=/music \
    GOMEMLIMIT=192MiB \
    GOGC=100
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/music-player-server"]
